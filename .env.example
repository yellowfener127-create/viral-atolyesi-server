# ElevenLabs → https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voice Library'den kopyalanan hazır ses ID'si (hesaba özel olabilir)
ELEVENLABS_VOICE_ID=

# İsteğe bağlı. Varsayılan: eleven_multilingual_v2
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# İsteğe bağlı. Boşsa output/hooks altına yazar.
ELEVENLABS_HOOK_DIR=

# 0 yazılırsa kanca sesi ve yayın kuyruğu çalışmaz.
PUBLISH_QUEUE=1
# Platformlar arası bekleme. Varsayılan 3 dakika.
PUBLISH_PLATFORM_GAP_MS=180000

# Instagram Reels (Graph API, resumable upload)
META_GRAPH_VERSION=v21.0
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Facebook sayfa Reels
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# X (Twitter) OAuth 1.0a kullanıcı anahtarları
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
